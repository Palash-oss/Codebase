# CodeBase X-Ray Production Environment Configuration

# Server Port & Host Environment
PORT=3001
NODE_ENV=production

# Razorpay Billing Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Custom Domain & Vercel DNS Configuration
CUSTOM_DOMAIN=https://techbuild.life
ALLOWED_ORIGINS=https://techbuild.life,http://localhost:5173

# Firebase Google OAuth Credentials
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=codebase-xray.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=codebase-xray
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# GitHub OAuth / Personal Access Token (Optional for higher rate limits)
GITHUB_TOKEN=ghp_...
