# CodeBase X-Ray Production Environment Configuration

# Server Port & Host Environment
PORT=3001
NODE_ENV=production

# Razorpay Billing Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Custom Domain & Origins
CUSTOM_DOMAIN=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Firebase Google OAuth Credentials
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=codebase-xray.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=codebase-xray
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# GitHub OAuth / Personal Access Token (Optional for higher rate limits)
GITHUB_TOKEN=ghp_...

# Google Gemini AI Assistant API Key
GEMINI_API_KEY=AIzaSy...

# Groq AI Assistant Fallback API Key (Llama 3.3 70B)
GROQ_API_KEY=gsk_...

# ─── GitHub Webhook Live Monitoring ──────────────────────────────────────────
# Set this to enable live auto-re-analysis when your monitored repo gets a push.
# 
# Setup Steps:
#   1. Go to: GitHub Repo → Settings → Webhooks → Add webhook
#   2. Payload URL: https://your-domain.com/api/webhook/github
#   3. Content type: application/json
#   4. Secret: paste the same value as WEBHOOK_SECRET below
#   5. Events: Just the push event
#   6. For local dev: use ngrok (ngrok http 3001) or Cloudflare Tunnel
#
# Leave blank to accept webhooks without signature validation (dev only!)
WEBHOOK_SECRET=your_webhook_secret_here
