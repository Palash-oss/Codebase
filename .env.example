# CodeBase X-Ray Production Environment Configuration

# Server Port & Host Environment
PORT=3001
NODE_ENV=production

# Razorpay Billing Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Custom Domain & Vercel DNS Configuration
CUSTOM_DOMAIN=https://codebasexray.com
ALLOWED_ORIGINS=https://codebasexray.com,http://localhost:5173

# GitHub OAuth / Personal Access Token (Optional for higher rate limits)
GITHUB_TOKEN=ghp_...
